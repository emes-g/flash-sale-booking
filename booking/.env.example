# [Usage]
# 1. Copy this file to .env
#    command: cp .env.example .env
# 2. Fill in the required values (e.g., DB_PASSWORD)
# 3. Run: docker-compose up -d

# --- Database Settings ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flash_sale_booking
DB_USERNAME=root
DB_PASSWORD={your_mysql_password}

# --- Redis Settings ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379